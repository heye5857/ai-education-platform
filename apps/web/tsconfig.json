{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/lib/*": ["./src/lib/*"],
      "@ai-edu/logger/*": ["../../packages/logger/src/*"],
      "@ai-edu/db/*": ["../../packages/db/src/*"],
      "@ai-edu/ai/*": ["../../packages/ai/src/*"],
      "@ai-edu/rag/*": ["../../packages/rag/src/*"],
      "@ai-edu/ui/*": ["../../packages/ui/src/*"],
      "@ai-edu/config/*": ["../../packages/config/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}